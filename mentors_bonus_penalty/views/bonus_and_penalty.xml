<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Bonus/Penalty Type-->

    <record id="hr_bonus_penalty_type_form_view" model="ir.ui.view">
        <field name="name">hr.bonus.penalty.type.form.view</field>
        <field name="model">hr.bonus.penalty.type</field>
        <field name="arch" type="xml">
            <form string="Types">
                <sheet>
                    <div class="oe_name">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group col="4">
                            <field name="type" options="{'horizontal': true}" required="True"/>
                            <field name="code" options="{'horizontal': true}" required="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_bonus_penalty_type_filter_view" model="ir.ui.view">
        <field name="name">hr.bonus.penalty.type.filter.view</field>
        <field name="model">hr.bonus.penalty.type</field>
        <field name="arch" type="xml">
            <search string="Bonus">
                <field name="name"/>
                <filter string="Bonuses" name="bonuses" domain="[('type','=','bonus')]" />
                <filter string="Penalties" name="penalties" domain="[('type','=','penalty')]" />
                <group expand="0" string="Group By">
                    <filter string="Type" name="type" domain="[]" context="{'group_by':'type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="act_hr_bonus_penalty_type" model="ir.actions.act_window">
        <field name="name">Bonus/Penalty Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.bonus.penalty.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_type': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Add New Bonus/Penalty Type
            </p>
        </field>
    </record>
<!--    <menuitem id="menu_hr_bonus_type"-->
<!--              parent="hr.menu_human_resources_configuration"-->
<!--              action="act_hr_bonus_penalty_type"-->
<!--              sequence="12"/>-->

    <!--Bonus/Penalties-->

    <record id="hr_bonus_penalty_form_view" model="ir.ui.view">
        <field name="name">hr.bonus.penalty.form.view</field>
        <field name="model">hr.bonus.penalty</field>
        <field name="arch" type="xml">
            <form string="Bonus">
                <header>
                    <button name="action_confirm" string="Confirm" class="oe_highlight"
                            groups="hr.group_hr_manager" state="draft" type="object"/>
                    <button name="action_cancel" string="Cancel"
                            groups="hr.group_hr_manager" state="draft,confirm" type="object"/>
                    <button name="action_reset" string="Rest To Draft"
                            groups="hr.group_hr_manager" state="cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Bonus/Penalty"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bonus/Penalty..."
                                   readonly = "state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly = "state != 'draft'"/>
                            <field name="period_month" readonly="1"/>
                        </group>
                        <group>
                            <field name="type" required="1" readonly = "state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employee's" name="lines">
                            <field name="line_ids" readonly = "state != 'draft'">
                                <list editable="bottom"
                                      decoration-primary="state == 'draft'"
                                      decoration-warning="state == 'cancel'"
                                      decoration-info="state == 'confirm'"
                                      decoration-success="state == 'done'">

                                    <field name="employee_number"/>
                                    <field name="employee_id" domain="[('registration_number', 'ilike', employee_number)]"/>
                                    <field name="type_id" domain="[('type','=',parent.type)]"/>
                                    <field name="type_code"  optional="hide"/>
                                    <field name="amount"/>
                                    <field name="amount_type"/>
                                    <field name="notes"/>
                                    <field name="state" readonly="1"/>
                                    <field name="date"/>
                                    <field name="payslip_id" readonly="1" optional="hide"
                                           invisible = "state != 'done'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>

            </form>
        </field>
    </record>
    <record id="hr_bonus_penalty_tree_view" model="ir.ui.view">
        <field name="name">hr.bonus.penalty.tree.view</field>
        <field name="model">hr.bonus.penalty</field>
        <field name="arch" type="xml">
            <list string="Bonus/Penalty"
                  decoration-primary="state == 'draft'"
                  decoration-warning="state == 'cancel'"
                  decoration-info="state == 'confirm'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="type"/>
                <field name="period_month"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="hr_bonus_penalty_filter_view" model="ir.ui.view">
        <field name="name">hr.bonus.penalty.filter.view</field>
        <field name="model">hr.bonus.penalty</field>
        <field name="arch" type="xml">
            <search string="Bonus/Penalty">
                <field name="name"/>
                <filter string="Bonuses" name="bonuses" domain="[('type','=','bonus')]" />
                <filter string="Penalties" name="penalties" domain="[('type','=','penalty')]" />
                <group expand="0" string="Group By">
                    <filter string="State" name="state" domain="[]" context="{'group_by':'state'}"/>
                    <filter string="Period" name="period" domain="[]" context="{'group_by':'period_month'}"/>
                    <filter string="Type" name="type" domain="[]" context="{'group_by':'type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="act_hr_bonus" model="ir.actions.act_window">
        <field name="name">Bonus/Penalty</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.bonus.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('hr_bonus_penalty_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hr_bonus_penalty_form_view')})]"/>
        <field name="context">{'search_default_type':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Add New Bonus/Penalty
            </p>
        </field>
    </record>
