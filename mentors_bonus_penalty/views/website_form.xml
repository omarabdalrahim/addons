<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="menu_member_form" model="website.menu">
            <field name="name">Create Member</field>
            <field name="url">/member_webform</field>
            <field name="parent_id" search="[('website_id', '=', 1)]"/>
            <field name="sequence" type="int">170</field>
            <field name="website_id" ref="website.default_website"/>
        </record>

        <template id="create_member" name="Create Member">
            <t t-call="website.layout">
                <div id="wrap">
                    <div class="oe_structure">
                        <div class="container">
                            <form role="form" action="/create/webpatient" method="POST">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="form-group">
                                    <label for="name" class="control_label">Player Name</label>
                                    <input type="text" name="name" t-att-value="name" id="name"
                                    class="form-control" placeholder="e.g. Mohamed Aboutrika" required="required"/>
                                </div>
                                <div class="form-group">
                                    <label for="vat" class="control_label">Tax ID</label>
                                    <input type="text" name="vat" t-att-value="vat" id="vat"
                                    class="form-control" required="required"/>
                                </div>
<!--                                <div class="form-group">-->
<!--                                    <label for="date_of_birth" class="control_label">Date of birth</label>-->
<!--                                    <input type="date" name="date_of_birth" t-att-value="date_of_birth" id="date_of_birth"-->
<!--                                    class="form-control" required="required"/>-->
<!--                                </div>-->
<!--                                <div class="form-group">-->
<!--                                    <label for="gender" class="control_label">Gender</label>-->
<!--                                    <div>-->
<!--                                        <label class="radio-inline">-->
<!--                                            <input type="radio" name="gender" t-att-checked="'male'"-->
<!--                                                   t-att-value="'male'"/>-->
<!--                                            Male-->
<!--                                        </label>-->
<!--                                        <label class="radio-inline">-->
<!--                                            <input type="radio" name="gender" t-att-checked="'female'"-->
<!--                                                   t-att-value="'female'"/>-->
<!--                                            Female-->
<!--                                        </label>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                                <div class="form-control" >-->
<!--                                    <label for="image" class="control_label">Upload Image</label>-->
<!--                                    <input type="file" name="image" class="form-control" accept="image/*" />-->
<!--                                </div>-->

                                <div class="clearfix oe_login_buttons">
                                    <div class="mt-3">
                                        <button type="submit" class="btn btn-primary pull-left">Create New Member</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </t>



        </template>

        <record id="member_thanks" model="website.page">
            <field name="name">Thanks</field>
            <field name="type">qweb</field>
            <field name="url">/patient-thank-you</field>
            <field name="website_published">True</field>
            <field name="key">competition.member_thanks</field>
            <field name="arch" type="xml">
                <t name="Thanks" t-name="mentors_bonus_penalty.member_thanks">
                    <t t-call="website.layout">
                        <div id="wrap">
                            <div class="container">
                                <h1>Thanks!</h1>
                                <div class="row">
                                    <div class="col-lg-8">
                                        <div class="alert alert-success" role="status">
                                            Your message has been sent successfully.
                                        </div>
                                        <p>
                                            We will get back to you shortly.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </field>
        </record>
    
    </data>
    

</odoo>
