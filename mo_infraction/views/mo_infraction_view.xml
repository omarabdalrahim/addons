<odoo>
    <data>
        <record id="infraction_view_form" model="ir.ui.view">
            <field name="name">infraction_view_form</field>
            <field name="model">mo.infraction</field>
            <field name="arch" type="xml">
                <form string="infraction_form">
                    <sheet>
                        <div class="oe_title">
                            <h3>
                                <field name="name" placeholder="Name..." widget="text"/>
                            </h3>
                        </div>
                        <group>
                            <field name="code"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="infraction_view_tree" model="ir.ui.view">
            <field name="name">infraction_view_tree</field>
            <field name="model">mo.infraction</field>
            <field name="arch" type="xml">
                <list string="infraction_tree">
                    <field name="name"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </list>
            </field>
        </record>


        <record id="mo_infraction_action" model="ir.actions.act_window">
            <field name="name">mo.infraction.action</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mo.infraction</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="infraction_menu_root" name="Infractions" parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
                  sequence="120"/>
        <menuitem id="infraction_menu_item" name="Infraction Type" parent="infraction_menu_root"
                  action="mo_infraction_action" sequence="15"/>

    </data>
</odoo>