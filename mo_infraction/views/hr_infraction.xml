<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_infraction_form_view" model="ir.ui.view">
        <field name="name">hr.infraction.form.view</field>
        <field name="model">hr.infraction</field>
        <field name="arch" type="xml">
            <form string="Infraction">
                <header>
                    <button name="action_confirm" string="Confirm" class="oe_highlight"
                            groups="hr.group_hr_manager" invisible="state != 'draft'" type="object"/>
                    <button name="action_cancel" string="Cancel"
                            groups="hr.group_hr_manager" invisible="state not in ['draft','confirm']" type="object"/>
                    <button name="action_reset" string="Rest To Draft"
                            groups="hr.group_hr_manager" invisible="state != 'cancel'" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Infraction"/>
                        <h1>
                            <field name="name" placeholder="e.g. Infraction..."
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state in ['confirm','done','cancel']"/>
                            <field name="period_month" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employee's" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom"
                                      decoration-primary="state == 'draft'"
                                      decoration-warning="state == 'cancel'"
                                      decoration-info="state == 'confirm'"
                                      decoration-success="state == 'done'">

                                    <field name="employee_number"/>
                                    <field name="employee_id"/>
                                    <field name="type_id"/>
                                    <field name="amount"/>
                                    <field name="amount_type"/>
                                    <field name="notes"/>
                                    <field name="state" readonly="1"/>
                                    <field name="date"/>
                                    <field name="payslip_id" readonly="1" optional="hide"
                                           invisible="state != 'done'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>


    <record id="hr_infraction_tree_view" model="ir.ui.view">
        <field name="name">hr.infraction.tree.view</field>
        <field name="model">hr.infraction</field>
        <field name="arch" type="xml">
            <list string="Infraction"
                  decoration-primary="state == 'draft'"
                  decoration-warning="state == 'cancel'"
                  decoration-info="state == 'confirm'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="period_month"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="act_hr_infraction" model="ir.actions.act_window">
        <field name="name">Infraction</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.infraction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_type':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Add New Infraction
            </p>
        </field>
    </record>
    <menuitem id="menu_hr_infraction"
              name="Infraction"
              parent="mo_infraction.infraction_menu_root"
              action="act_hr_infraction"
              sequence="2"/>

</odoo>
